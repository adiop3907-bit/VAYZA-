rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'senjaaba221@gmail.com' ||
        request.auth.token.email.lower() == 'adiop3907@gmail.com'
      );
    }

    // Products Collection
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin() && isValidId(productId);
    }

    // Orders Collection
    match /orders/{orderId} {
      // Customers can create orders during checkout
      allow create: if isValidId(orderId) &&
        request.resource.data.orderNumber is string &&
        request.resource.data.totalAmount is number &&
        request.resource.data.customer is map;

      // Super admin can read, list and manage all orders
      allow get, list, update, delete: if isSuperAdmin() && isValidId(orderId);
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      // Anyone can read published reviews
      allow get, list: if resource.data.status == 'publie' || isSuperAdmin();

      // Customers can submit a review in pending status
      allow create: if isValidId(reviewId) &&
        request.resource.data.productId is string &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 1000;

      // Super admin can approve, reject or delete reviews
      allow update, delete: if isSuperAdmin() && isValidId(reviewId);
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow get, list: if resource.data.isActive == true || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin() && isValidId(couponId);
    }

    // Site Settings Collection
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin() && isValidId(settingId);
    }

    // Customer Profiles Collection
    match /customers/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // Admin Users Collection
    match /admins/{adminId} {
      allow read, write: if isSuperAdmin() && isValidId(adminId);
    }
  }
}
